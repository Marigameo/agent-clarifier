{
  "name": "@marigameo/agent-clarifier",
  "version": "0.1.0",
  "description": "A web component that lets a chat agent ask clarifying questions before it acts.",
  "license": "MIT",
  "author": "Mariappan <mari@strivelabs.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marigameo/agent-clarifier.git"
  },
  "homepage": "https://github.com/Marigameo/agent-clarifier#readme",
  "bugs": {
    "url": "https://github.com/Marigameo/agent-clarifier/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map",
    "types"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/claude": {
      "types": "./dist/adapters/claude.d.ts",
      "default": "./dist/adapters/claude.js"
    },
    "./adapters/mcp": {
      "types": "./dist/adapters/mcp.d.ts",
      "default": "./dist/adapters/mcp.js"
    },
    "./jsx": {
      "types": "./types/jsx.d.ts",
      "default": "./types/jsx.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "agent",
    "clarifying-questions",
    "chat",
    "ai"
  ],
  "scripts": {
    "dev": "vite --open /demo/",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tests/types",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "size-limit",
    "lint:pkg": "publint && attw --pack . --profile esm-only",
    "check": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm build && pnpm size && pnpm lint:pkg",
    "prepublishOnly": "pnpm check"
  },
  "size-limit": [
    {
      "name": "core (gzipped; budget set in round 22, see BUILD §0)",
      "path": [
        "dist/index.js",
        "dist/ids-*.js"
      ],
      "limit": "21.5 KB",
      "gzip": true
    },
    {
      "name": "core (brotli, what CDNs send)",
      "path": [
        "dist/index.js",
        "dist/ids-*.js"
      ],
      "limit": "19.2 KB",
      "brotli": true
    },
    {
      "name": "Claude converter",
      "path": [
        "dist/adapters/claude.js",
        "dist/ids-*.js"
      ],
      "limit": "1.5 KB",
      "gzip": true
    },
    {
      "name": "MCP converter",
      "path": [
        "dist/adapters/mcp.js",
        "dist/ids-*.js"
      ],
      "limit": "1.5 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/file": "^14.2.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "playwright-core": "^1.64.0",
    "publint": "^0.3.25",
    "react": "19",
    "react-dom": "19",
    "size-limit": "^14.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue": "3"
  }
}
